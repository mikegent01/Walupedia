      "type": "feat",
      "img": "icons/magic/unholy/strike-body-explode-disintegrate.webp",
      "system": {
        "description": {
          "value": "<p>A 20-foot cube within 90 feet fills with green fire that is not fire. Each creature in it makes a DC 16 Dexterity saving throw, taking 6d8 necrotic damage on a failure or half as much on a success. Banners catch at their lower edges; the cube is difficult terrain until the end of her next turn.</p>",
          "chat": ""
        },
        "type": {
          "value": "monster",
          "subtype": ""
