    {
      "name": "Troop-Issue Spear",
      "type": "weapon",
      "img": "icons/weapons/polearms/javelin-flared.webp",
      "system": {
        "description": {
          "value": "<p>A standard-issue spear provided to Koopa Troop infantry, designed for koopa proportions and fighting styles. The spear is slightly shorter than human equivalent weapons, compensating for koopas' smaller stature while maintaining adequate reach to threaten enemies before they get close enough to stomp. The spearhead is mass-produced in Darkland foundries with quality that is adequate without being impressive—sharp enough for combat, durable enough for field conditions, replaceable enough that losing one doesn't require paperwork that takes longer than the battle did.</p>",
          "chat": "<p>Standard issue, standard quality, standard pointing-end-toward-enemy training. The spear does its job because the Troopa behind it does theirs.</p>"
        },
        "unidentified": {
          "name": "Military Spear",
          "description": "<p>A standard-issue spear of adequate quality, designed for small humanoid proportions.</p>"
