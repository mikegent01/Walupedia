    {
      "_id": "PxJnaPThpwscstxr",
      "name": "The Reason the Liberated Toads Exist",
      "type": "feat",
      "img": "icons/sundries/flags/banner-flag-blue.webp",
      "system": {
        "description": {
          "value": "<p><em>Barrel Survivors specialisations: Testimony, Unity, Moral authority.</em></p><p><strong>Testimony.</strong> Barrel Survivor was in the barrels: when Barrel Survivor tells it, Barrel Survivor has advantage on Charisma (Persuasion) checks against anyone who was not there. <strong>Unity.</strong> Barrel Survivor has advantage on saving throws against being frightened while another Barrel Survivor is within 10 feet. <strong>Moral authority.</strong> In a Liberated Toads assembly Barrel Survivor's vote counts as the docket says it does, and a cohort toad who shouts Barrel Survivor down loses the floor.</p>",
          "chat": ""
        },
        "type": {
