    {
      "name": "Bottle Trap",
      "type": "feat",
      "system": {
        "description": {
          "value": "<p>A haint that enters the space of an upright, empty bottle must succeed on a DC 16 Charisma saving throw or be drawn into the bottle, and a cork or stopper appears to close the bottle. The trapped haint can see and hear through the bottle out to 10 feet, and any creature in that range can hear the haint. The haint is released if the bottle breaks or another creature opens it.</p>",
          "chat": ""
        },
