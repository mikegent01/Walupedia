      "_id": "pr9cayzDt9J8M6RJ",
      "name": "Constricting Vines",
      "type": "weapon",
      "img": "icons/magic/nature/root-vines-knot-brown.webp",
      "effects": [],
      "folder": null,
      "sort": 600000,
